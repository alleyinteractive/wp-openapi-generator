{
    "name": "alleyinteractive/wp-openapi-generator",
    "description": "Generate an OpenAPI document for the WordPress REST API and browse it with Swagger UI.",
    "type": "wordpress-plugin",
    "keywords": [
        "alleyinteractive",
        "wp-openapi-generator"
    ],
    "homepage": "https://github.com/alleyinteractive/wp-openapi-generator",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Sean Fisher",
            "email": "sean@alley.com"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "alleyinteractive/alley-coding-standards": "^2.0",
        "mantle-framework/testkit": "^1.0",
        "php-stubs/wp-cli-stubs": "dev-master",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Alley\\WP\\OpenAPI_Generator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alley\\WP\\OpenAPI_Generator\\Tests\\": "tests"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "phpcbf": "phpcbf .",
        "phpcs": "phpcs .",
        "phpunit": "phpunit",
        "phpstan": "phpstan --memory-limit=512M",
        "test": [
            "@phpcs",
            "@phpstan",
            "@phpunit"
        ]
    }
}
